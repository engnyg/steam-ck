<Page
    x:Class="OpenSteamUnlocker.App.Views.Pages.TrainersPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="TrainersPage"
    d:DesignHeight="720"
    d:DesignWidth="1000"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  Fixed header  -->
        <StackPanel Grid.Row="0" Margin="24,24,24,0">

            <TextBlock
                FontSize="28"
                FontWeight="SemiBold"
                Text="修改器管理" />

            <!--  Search bar + external search  -->
            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:TextBox
                    Grid.Column="0"
                    PlaceholderText="篩選已新增的修改器名稱…"
                    Text="{Binding ViewModel.SearchQuery, UpdateSourceTrigger=PropertyChanged}" />
                <ui:Button
                    Grid.Column="1"
                    Margin="8,0,0,0"
                    Command="{Binding ViewModel.SearchOnFlingCommand}"
                    Content="FLiNG"
                    Icon="{ui:SymbolIcon Open24}"
                    ToolTip="在 FLiNG Trainer 搜尋" />
                <ui:Button
                    Grid.Column="2"
                    Margin="6,0,0,0"
                    Command="{Binding ViewModel.SearchOnWemodCommand}"
                    Content="WeMod"
                    Icon="{ui:SymbolIcon Open24}"
                    ToolTip="在 WeMod 搜尋" />
                <ui:Button
                    Grid.Column="3"
                    Margin="6,0,0,0"
                    Appearance="Primary"
                    Command="{Binding ViewModel.AddTrainerCommand}"
                    Content="新增修改器"
                    Icon="{ui:SymbolIcon Add24}" />
            </Grid>

            <!--  Status banner  -->
            <ui:InfoBar
                Margin="0,8,0,0"
                IsOpen="{Binding ViewModel.ShowStatus}"
                Message="{Binding ViewModel.StatusText}"
                Severity="Warning"
                Title="提示" />

            <TextBlock
                Margin="0,8,0,0"
                FontSize="12"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Text="新增本機修改器 .exe，或點擊外部按鈕在瀏覽器中搜尋並下載。" />
        </StackPanel>

        <!--  Trainer list  -->
        <ScrollViewer
            Grid.Row="1"
            Margin="16,8,16,16"
            VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding ViewModel.FilteredTrainers}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <ui:Card Margin="8,4,8,4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!--  Info  -->
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock
                                        FontSize="14"
                                        FontWeight="SemiBold"
                                        Text="{Binding Name}"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        Margin="0,2,0,0"
                                        FontSize="11"
                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                        Text="{Binding ExePath}"
                                        TextTrimming="CharacterEllipsis"
                                        ToolTip="{Binding ExePath}" />
                                    <TextBlock
                                        Margin="0,2,0,0"
                                        FontSize="11"
                                        Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                        Text="{Binding AddedAt, StringFormat='新增於 {0:yyyy-MM-dd}'}" />
                                </StackPanel>

                                <!--  Launch  -->
                                <ui:Button
                                    Grid.Column="1"
                                    Margin="8,0,0,0"
                                    Appearance="Primary"
                                    Command="{Binding DataContext.ViewModel.LaunchTrainerCommand,
                                        RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding}"
                                    Content="啟動"
                                    Icon="{ui:SymbolIcon Play24}" />

                                <!--  Remove  -->
                                <ui:Button
                                    Grid.Column="2"
                                    Margin="6,0,0,0"
                                    Appearance="Danger"
                                    Command="{Binding DataContext.ViewModel.RemoveTrainerCommand,
                                        RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding}"
                                    Content="移除"
                                    Icon="{ui:SymbolIcon Delete24}" />
                            </Grid>
                        </ui:Card>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Page>
