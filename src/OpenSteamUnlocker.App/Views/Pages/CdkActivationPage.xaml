<Page
    x:Class="OpenSteamUnlocker.App.Views.Pages.CdkActivationPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="CdkActivationPage"
    d:DesignHeight="720"
    d:DesignWidth="900"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,24,24,24" MaxWidth="640">

            <!--  Page title  -->
            <StackPanel Orientation="Horizontal">
                <ui:SymbolIcon
                    Margin="0,4,10,0"
                    FontSize="28"
                    Symbol="Key24" />
                <TextBlock
                    FontSize="28"
                    FontWeight="SemiBold"
                    Text="序號啟動" />
            </StackPanel>
            <TextBlock
                Margin="0,6,0,0"
                FontSize="13"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Text="輸入 Steam 遊戲序號（CDK），一鍵兌換遊戲到你的 Steam 帳號" />

            <Separator Margin="0,20,0,20" />

            <!--  Key input card  -->
            <ui:Card Padding="20">
                <StackPanel>
                    <TextBlock
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="遊戲序號" />
                    <TextBlock
                        Margin="0,4,0,14"
                        FontSize="12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="Steam 序號格式：XXXXX-XXXXX-XXXXX（3～5 組，每組 5 碼）" />

                    <!--  Input row  -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <ui:TextBox
                            x:Name="KeyBox"
                            Grid.Column="0"
                            CharacterCasing="Upper"
                            FontFamily="Consolas"
                            FontSize="15"
                            KeyDown="KeyBox_KeyDown"
                            PlaceholderText="XXXXX-XXXXX-XXXXX"
                            Text="{Binding ViewModel.CdkKey, UpdateSourceTrigger=PropertyChanged}" />

                        <ui:Button
                            Grid.Column="1"
                            Margin="8,0,0,0"
                            Command="{Binding ViewModel.PasteCommand}"
                            Content="貼上"
                            Icon="{ui:SymbolIcon ClipboardPaste24}"
                            ToolTip="從剪貼簿貼上" />

                        <ui:Button
                            Grid.Column="2"
                            Margin="6,0,0,0"
                            Command="{Binding ViewModel.ClearCommand}"
                            Content="清除"
                            Icon="{ui:SymbolIcon Delete24}"
                            ToolTip="清除輸入" />
                    </Grid>

                    <!--  Activate button  -->
                    <ui:Button
                        Margin="0,14,0,0"
                        HorizontalAlignment="Left"
                        Appearance="Primary"
                        Command="{Binding ViewModel.ActivateCommand}"
                        Content="啟動序號"
                        FontSize="14"
                        Icon="{ui:SymbolIcon ArrowRight24}" />
                </StackPanel>
            </ui:Card>

            <!--  Success banner  -->
            <ui:InfoBar
                Margin="0,10,0,0"
                IsClosable="True"
                IsOpen="{Binding ViewModel.ShowSuccess}"
                Message="{Binding ViewModel.StatusMessage}"
                Severity="Success"
                Title="啟動視窗已開啟" />

            <!--  Error banner  -->
            <ui:InfoBar
                Margin="0,10,0,0"
                IsClosable="True"
                IsOpen="{Binding ViewModel.ShowError}"
                Message="{Binding ViewModel.StatusMessage}"
                Severity="Error"
                Title="啟動失敗" />

            <!--  How-to card  -->
            <ui:Card Margin="0,20,0,0" Padding="20">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon
                            Margin="0,2,8,0"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Symbol="Info24" />
                        <TextBlock
                            FontSize="14"
                            FontWeight="SemiBold"
                            Text="使用說明" />
                    </StackPanel>

                    <StackPanel Margin="0,12,0,0">
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                Grid.Column="0"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource SystemAccentColorPrimaryBrush}"
                                Text="①" />
                            <TextBlock Grid.Column="1" Text="輸入或貼上 Steam 遊戲序號" TextWrapping="Wrap" />
                        </Grid>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                Grid.Column="0"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource SystemAccentColorPrimaryBrush}"
                                Text="②" />
                            <TextBlock Grid.Column="1" Text="點選「啟動序號」按鈕" TextWrapping="Wrap" />
                        </Grid>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                Grid.Column="0"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource SystemAccentColorPrimaryBrush}"
                                Text="③" />
                            <TextBlock
                                Grid.Column="1"
                                Text="Steam 啟動視窗開啟後，按 Ctrl+V 貼上序號"
                                TextWrapping="Wrap" />
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                Grid.Column="0"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource SystemAccentColorPrimaryBrush}"
                                Text="④" />
                            <TextBlock
                                Grid.Column="1"
                                Text="按「下一步」→「我同意」→「完成」，遊戲將加入你的遊戲庫"
                                TextWrapping="Wrap" />
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </ui:Card>

        </StackPanel>
    </ScrollViewer>
</Page>
