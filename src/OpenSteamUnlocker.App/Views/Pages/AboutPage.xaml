<Page
    x:Class="OpenSteamUnlocker.App.Views.Pages.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="AboutPage"
    d:DesignHeight="700"
    d:DesignWidth="900"
    mc:Ignorable="d">

    <ScrollViewer Margin="24" VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="600" HorizontalAlignment="Left">

            <TextBlock
                FontSize="28"
                FontWeight="SemiBold"
                Text="關於" />

            <!--  App Identity Card  -->
            <ui:Card Margin="0,16,0,0">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!--  Icon  -->
                        <Border
                            Grid.Column="0"
                            Width="64"
                            Height="64"
                            Margin="0,0,16,0"
                            Background="{DynamicResource AccentFillColorDefaultBrush}"
                            CornerRadius="12">
                            <ui:SymbolIcon
                                FontSize="32"
                                Foreground="White"
                                Symbol="Games24" />
                        </Border>

                        <!--  Name + Version  -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock
                                FontSize="22"
                                FontWeight="Bold"
                                Text="{Binding ViewModel.AppName, Mode=OneWay}" />
                            <TextBlock
                                Margin="0,4,0,0"
                                FontSize="14"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Text="{Binding ViewModel.Version, Mode=OneWay}" />
                        </StackPanel>
                    </Grid>

                    <Separator Margin="0,16,0,16" />

                    <TextBlock
                        FontSize="14"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="一款專為台灣玩家設計的 Steam 解鎖工具，整合多個開源 manifest 資料庫，自動生成 OpenSteamTool 所需的 Lua 腳本，讓您輕鬆入庫遊戲。"
                        TextWrapping="Wrap" />
                </StackPanel>
            </ui:Card>

            <!--  Links Card  -->
            <ui:Card Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,12"
                        FontSize="13"
                        FontWeight="SemiBold"
                        Text="相關連結" />

                    <ui:Button
                        Command="{Binding ViewModel.OpenGitHubCommand}"
                        Content="{Binding ViewModel.GitHubUrl, Mode=OneWay}"
                        Icon="{ui:SymbolIcon Open24}" />
                </StackPanel>
            </ui:Card>

            <!--  Tech Stack Card  -->
            <ui:Card Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,12"
                        FontSize="13"
                        FontWeight="SemiBold"
                        Text="技術資訊" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                        </Grid.RowDefinitions>

                        <TextBlock
                            Grid.Row="0" Grid.Column="0"
                            Margin="0,0,24,6"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="框架" />
                        <TextBlock
                            Grid.Row="0" Grid.Column="1"
                            Margin="0,0,0,6"
                            Text=".NET 10 / WPF" />

                        <TextBlock
                            Grid.Row="1" Grid.Column="0"
                            Margin="0,0,24,6"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="UI 套件" />
                        <TextBlock
                            Grid.Row="1" Grid.Column="1"
                            Margin="0,0,0,6"
                            Text="WPF-UI (Fluent Design)" />

                        <TextBlock
                            Grid.Row="2" Grid.Column="0"
                            Margin="0,0,24,6"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="金鑰來源" />
                        <TextBlock
                            Grid.Row="2" Grid.Column="1"
                            Margin="0,0,0,6"
                            Text="Sudama DB / ManifestAutoUpdate" />

                        <TextBlock
                            Grid.Row="3" Grid.Column="0"
                            Margin="0,0,24,0"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="引擎" />
                        <TextBlock
                            Grid.Row="3" Grid.Column="1"
                            Text="OpenSteamTool" />
                    </Grid>
                </StackPanel>
            </ui:Card>

            <!--  Copyright  -->
            <TextBlock
                Margin="0,16,0,0"
                FontSize="12"
                Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                HorizontalAlignment="Center">
                <Run Text="© " />
                <Run Text="{Binding ViewModel.CopyrightYear, Mode=OneWay}" />
                <Run Text=" engnyg — 開源 MIT 授權" />
            </TextBlock>

        </StackPanel>
    </ScrollViewer>
</Page>
