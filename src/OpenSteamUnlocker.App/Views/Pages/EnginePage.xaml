<Page
    x:Class="OpenSteamUnlocker.App.Views.Pages.EnginePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="EnginePage"
    d:DesignHeight="700"
    d:DesignWidth="900"
    mc:Ignorable="d">

    <ScrollViewer Margin="24" VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock
                FontSize="28"
                FontWeight="SemiBold"
                Text="解鎖引擎" />

            <!--  Status card  -->
            <ui:Card Margin="0,16,0,0">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock FontWeight="SemiBold" Text="{Binding ViewModel.StatusText, Mode=OneWay}" />
                            <TextBlock
                                Margin="0,4,0,0"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Text="{Binding ViewModel.SteamPath, Mode=OneWay}"
                                TextWrapping="Wrap" />
                            <TextBlock
                                Margin="0,2,0,0"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Text="{Binding ViewModel.LuaDirectory, Mode=OneWay}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <ui:Button
                            Grid.Column="1"
                            VerticalAlignment="Top"
                            Command="{Binding ViewModel.RefreshCommand}"
                            Content="重新整理"
                            Icon="{ui:SymbolIcon ArrowSync24}" />
                    </Grid>

                    <StackPanel Margin="0,12,0,0" Orientation="Horizontal">
                        <ui:Button
                            Appearance="Primary"
                            Command="{Binding ViewModel.InstallCommand}"
                            Content="安裝引擎"
                            Icon="{ui:SymbolIcon ArrowDownload24}" />
                        <ui:Button
                            Margin="12,0,0,0"
                            Command="{Binding ViewModel.UninstallCommand}"
                            Content="移除引擎"
                            Icon="{ui:SymbolIcon Delete24}" />
                    </StackPanel>

                    <TextBlock
                        Margin="0,10,0,0"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{Binding ViewModel.Message, Mode=OneWay}"
                        TextWrapping="Wrap" />
                </StackPanel>
            </ui:Card>

        </StackPanel>
    </ScrollViewer>
</Page>
