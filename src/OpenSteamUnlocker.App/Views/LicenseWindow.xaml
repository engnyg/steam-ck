<ui:FluentWindow
    x:Class="OpenSteamUnlocker.App.Views.LicenseWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="授權驗證"
    Width="480"
    Height="320"
    ExtendsContentIntoTitleBar="True"
    ResizeMode="NoResize"
    WindowBackdropType="Mica"
    WindowCornerPreference="Round"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar
            Title="授權驗證"
            Grid.Row="0"
            ShowMinimize="False"
            ShowMaximize="False" />

        <StackPanel
            Grid.Row="1"
            Margin="32,16,32,32"
            VerticalAlignment="Center">

            <!--  Icon + Title  -->
            <StackPanel Margin="0,0,0,20" Orientation="Horizontal" HorizontalAlignment="Center">
                <Border
                    Width="48"
                    Height="48"
                    Margin="0,0,12,0"
                    Background="{DynamicResource AccentFillColorDefaultBrush}"
                    CornerRadius="10">
                    <ui:SymbolIcon FontSize="24" Foreground="White" Symbol="Key24" />
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock FontSize="20" FontWeight="SemiBold" Text="LYSTORE入庫" />
                    <TextBlock
                        FontSize="12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="請輸入您的授權金鑰以繼續使用" />
                </StackPanel>
            </StackPanel>

            <!--  Purchase link  -->
            <TextBlock Margin="0,0,0,12" FontSize="12" HorizontalAlignment="Center">
                <Run Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="購買金鑰：" />
                <Hyperlink NavigateUri="https://dc.engnyg.win/" RequestNavigate="OnPurchaseLinkClick">
                    https://dc.engnyg.win/
                </Hyperlink>
            </TextBlock>

            <!--  Key input  -->
            <ui:TextBox
                PlaceholderText="STEAM-XXXXXXXX-XXXX-XXXX-XXXX-XXXXXXXXXXXX"
                Text="{Binding ViewModel.LicenseKey, UpdateSourceTrigger=PropertyChanged}"
                FontFamily="Consolas"
                IsEnabled="{Binding ViewModel.IsBusy, Converter={StaticResource InverseBool}}" />

            <!--  Status message  -->
            <TextBlock
                Margin="0,8,0,0"
                FontSize="12"
                Text="{Binding ViewModel.StatusMessage}"
                TextWrapping="Wrap">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ViewModel.IsError}" Value="True">
                                <Setter Property="Foreground" Value="#F44336" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <!--  Verify button  -->
            <ui:Button
                Margin="0,14,0,0"
                HorizontalAlignment="Stretch"
                Appearance="Primary"
                Command="{Binding ViewModel.VerifyCommand}"
                IsEnabled="{Binding ViewModel.IsBusy, Converter={StaticResource InverseBool}}"
                Icon="{ui:SymbolIcon ShieldCheckmark24}">
                <ui:Button.Content>
                    <StackPanel Orientation="Horizontal">
                        <ui:ProgressRing
                            Width="16"
                            Height="16"
                            Margin="0,0,8,0"
                            IsIndeterminate="True"
                            Visibility="{Binding ViewModel.IsBusy, Converter={StaticResource BoolToVis}}" />
                        <TextBlock>
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="驗證金鑰" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ViewModel.IsBusy}" Value="True">
                                            <Setter Property="Text" Value="驗證中..." />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </ui:Button.Content>
            </ui:Button>

        </StackPanel>
    </Grid>
</ui:FluentWindow>
