<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <!-- Bundled OpenSteamTool engine binaries (copied next to the exe under engine\). -->
    <None Include="engine\**" CopyToOutputDirectory="PreserveNewest" LinkBase="engine\" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OpenSteamUnlocker.Core\OpenSteamUnlocker.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.9" />
    <PackageReference Include="WPF-UI" Version="4.3.0" />
    <PackageReference Include="WPF-UI.DependencyInjection" Version="4.3.0" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

</Project>
