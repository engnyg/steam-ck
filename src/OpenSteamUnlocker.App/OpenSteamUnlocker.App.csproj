<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <!-- Bundled OpenSteamTool engine binaries (copied next to the exe under engine\). -->
    <None Include="engine\**" CopyToOutputDirectory="PreserveNewest" LinkBase="engine\" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OpenSteamUnlocker.Core\OpenSteamUnlocker.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.9" />
    <PackageReference Include="WPF-UI" Version="4.3.0" />
    <PackageReference Include="WPF-UI.DependencyInjection" Version="4.3.0" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- Version metadata -->
    <AssemblyName>OpenSteamUnlocker</AssemblyName>
    <RootNamespace>OpenSteamUnlocker.App</RootNamespace>
    <Version>1.0.3</Version>
    <AssemblyVersion>1.0.3.0</AssemblyVersion>
    <FileVersion>1.0.3.0</FileVersion>
    <Product>OpenSteam Unlocker</Product>
    <Company>LYSTORE</Company>
    <Copyright>© 2024 LYSTORE</Copyright>
    <Description>Steam library unlocker with manifest installer and engine integration</Description>
    <NeutralLanguage>zh-TW</NeutralLanguage>
  </PropertyGroup>

  <!-- Publish: single-file self-contained win-x64 -->
  <PropertyGroup Condition="'$(PublishSingleFile)' == 'true'">
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- WPF does not support IL trimming -->
    <PublishTrimmed>false</PublishTrimmed>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

</Project>
